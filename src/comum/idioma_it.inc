{ L"Usar outro modelo", L"Usa un altro modello" },
{ L"Colar nome", L"Incolla nome" },
{ L"Copie o nome do modelo no site do serviço e cole aqui.", L"Copia il nome del modello dal sito del servizio e incollalo qui." },
{ L"Chave da API", L"Chiave API" },
{ L"Colar chave", L"Incolla chiave" },
{ L"Nenhuma chave. Copie a chave e clique em Colar chave.", L"Nessuna chiave. Copia la chiave e fai clic su Incolla chiave." },
{ L"Apagar a chave deste PC", L"Elimina la chiave da questo PC" },
{ L"O Ollama roda no próprio PC (ollama.com): as perguntas não saem dele.", L"Ollama gira su questo PC (ollama.com): le domande non escono da qui." },
{ L"Copie a chave no site do serviço (o Gemini e o Groq têm chave grátis) e use \"Colar chave\". A chave fica cifrada nesta conta do Windows, e as perguntas vão direto do PC para o serviço.", L"Copia la chiave dal sito del servizio (Gemini e Groq hanno chiavi gratuite) e usa \"Incolla chiave\". La chiave è cifrata per questo account Windows e le domande vanno direttamente dal PC al servizio." },
{ L"Escolha um serviço para a Siri em Ajustes do Sistema > Apple Intelligence e Siri.", L"Scegli un servizio per Siri in Impostazioni di Sistema > Apple Intelligence e Siri." },
{ L"Falta a chave da API. Cole a chave em Ajustes do Sistema > Apple Intelligence e Siri.", L"Manca la chiave API. Incollala in Impostazioni di Sistema > Apple Intelligence e Siri." },
{ L"Não deu para falar com o Ollama neste PC. Ele está aberto?", L"Impossibile raggiungere Ollama su questo PC. È aperto?" },
{ L"Não deu para falar com o serviço. Confira a internet.", L"Impossibile raggiungere il servizio. Controlla la connessione a internet." },
{ L"O serviço respondeu sem texto.", L"Il servizio ha risposto senza testo." },
{ L"Chave recusada pelo serviço.", L"Il servizio ha rifiutato la chiave." },
{ L"O serviço recusou a pergunta", L"Il servizio ha rifiutato la domanda" },
