{ L"Usar IA: escolha um serviço em Ajustes do Sistema > Apple Intelligence e Siri", L"Usa l’IA: scegli un servizio in Impostazioni di Sistema > Apple Intelligence e Siri" },
{ L"Separar os apps abertos que não estão no Dock", L"Separa le app aperte che non sono nel Dock" },
{ L"Pôr os ícones fora do formato num quadrado cinza (Tahoe e Golden Gate)", L"Metti le icone fuori formato in un quadrato grigio (Tahoe e Golden Gate)" },
{ L"Atalho do Spotlight", L"Scorciatoia di Spotlight" },
{ L"Win+Espaço", L"Win+Spazio" },
{ L"Alt+Espaço", L"Alt+Spazio" },
{ L"Ctrl+Espaço", L"Ctrl+Spazio" },
{ L"Com Alt+Espaço ou Ctrl+Espaço, o Win+Espaço volta a trocar o idioma do teclado no Windows.", L"Con Alt+Spazio o Ctrl+Spazio, Win+Spazio torna a cambiare la lingua della tastiera in Windows." },
{ L"Uso do Sistema", L"Uso del sistema" },
{ L"Mostra o uso em porcentagem na barra de menus, atualizado a cada segundo. O disco é o espaço ocupado no disco do Windows. Clique para abrir o Monitor de Atividade.", L"Mostra l’uso in percentuale nella barra dei menu, aggiornato ogni secondo. Il disco è lo spazio occupato sul disco di Windows. Fai clic per aprire Monitoraggio Attività." },
{ L"Mostrar a barra de menus em tela cheia", L"Mostra la barra dei menu a tutto schermo" },
{ L"Com um app em tela cheia, leve o ponteiro até o topo da tela para a barra aparecer. Nunca em jogos.", L"Con un’app a tutto schermo, porta il puntatore in cima allo schermo per mostrare la barra. Mai nei giochi." },
{ L"%ls disponíveis de %ls", L"%ls disponibili su %ls" },
{ L"Mostrar na barra lateral:", L"Mostra nella barra laterale:" },
{ L"Mostrar Barra de Caminho", L"Mostra barra percorso" },
{ L"Usar como Imagem da Mesa", L"Imposta come immagine della scrivania" },
{ L"Não foi possível usar esta imagem na mesa", L"Impossibile usare questa immagine per la scrivania" },
{ L"Renomear…", L"Rinomina…" },
{ L"O nome novo aparece no Dock, no Launchpad e na barra de menus. Deixe vazio para voltar ao nome original.", L"Il nuovo nome appare nel Dock, nel Launchpad e nella barra dei menu. Lascia vuoto per tornare al nome originale." },
{ L"Apps", L"App" },
{ L"Instruções personalizadas", L"Istruzioni personalizzate" },
{ L"Nenhuma. Escreva o que a Siri deve saber sobre você e como ela deve responder.", L"Nessuna. Scrivi cosa Siri deve sapere di te e come deve rispondere." },
{ L"# Instruções personalizadas da Siri: escreva abaixo o que ela deve saber sobre você e como deve responder.", L"# Istruzioni personalizzate di Siri: scrivi sotto cosa deve sapere di te e come deve rispondere." },
{ L"# Linhas que começam com # são ignoradas. Salve o arquivo; vale já na próxima pergunta.", L"# Le righe che iniziano con # vengono ignorate. Salva il file; vale dalla prossima domanda." },
{ L"Vão junto com cada pergunta, em qualquer serviço (inclusive os modelos no PC).", L"Inviate con ogni domanda, con qualsiasi servizio (anche i modelli locali)." },
{ L"Editar…", L"Modifica…" },
{ L"Ocultar o app", L"Nascondi l’app" },
{ L"Digitação por voz do Windows", L"Digitazione vocale di Windows" },
{ L"Mostrar o Finder", L"Mostra il Finder" },
{ L"Desligado, o Finder só aparece no Dock com uma janela aberta.", L"Se disattivato, il Finder appare nel Dock solo con una finestra aperta." },
{ L"Altura da barra de menus", L"Altezza della barra dei menu" },
{ L"Menor", L"Più bassa" },
{ L"Maior", L"Più alta" },
{ L"%ls disponíveis", L"%ls disponibili" },
{ L"O Windows não confirmou a senha (erro %lu). Tente de novo ou use Ctrl⁠+⁠Alt⁠+⁠Del → Bloquear.", L"Windows non ha confermato la password (errore %lu). Riprova o usa Ctrl⁠+⁠Alt⁠+⁠Canc → Blocca." },
{ L"Alt+Tab: seletor de apps do Mac", L"Alt+Tab: selettore app del Mac" },
{ L"Ferramenta de Captura", L"Strumento di cattura" },
{ L"Win+Shift+S e a Central de Controle abrem a Ferramenta de Captura do Windows, com gravação de tela.", L"Win+Maiusc+S e Centro di Controllo aprono lo Strumento di cattura di Windows, con la registrazione dello schermo." },
{ L"Configurações do Windows", L"Impostazioni di Windows" },
{ L"Win+I e os atalhos de rede, Bluetooth, telas, som e energia abrem as Configurações do Windows. O Ajustes do Sistema continua no menu da Apple.", L"Win+I e le scorciatoie di rete, Bluetooth, schermi, suono ed energia aprono le Impostazioni di Windows. Impostazioni di Sistema resta nel menu Apple." },
{ L"Ctrl+Shift+Esc, o uso do sistema na barra de menus e a Central de Controle abrem o Gerenciador de Tarefas.", L"Ctrl+Maiusc+Esc, l’uso del sistema nella barra dei menu e Centro di Controllo aprono Gestione attività." },
{ L"Calculadora do Windows", L"Calcolatrice di Windows" },
{ L"A Calculadora do Windows não é trocada pela do WacOS.", L"La Calcolatrice di Windows non viene sostituita da quella di WacOS." },
{ L"Terminal do Windows", L"Terminale Windows" },
{ L"A Central de Controle abre o Terminal do Windows (ou o PowerShell).", L"Centro di Controllo apre il Terminale Windows (o PowerShell)." },
{ L"Música e vídeo no app padrão", L"Musica e video nell’app predefinita" },
{ L"Áudio e vídeo abrem no app padrão do Windows (VLC, mpv...), não no Música e no QuickTime Player.", L"Audio e video si aprono nell’app predefinita di Windows (VLC, mpv...), non in Musica e QuickTime Player." },
{ L"Imagens, PDF e texto no app padrão", L"Immagini, PDF e testo nell’app predefinita" },
{ L"Abrir pelo Quick Look usa o app padrão do Windows, não a Pré-Visualização e o TextEdit.", L"Aprire da Quick Look usa l’app predefinita di Windows, non Anteprima e TextEdit." },
{ L"Teclas de mídia do Windows", L"Tasti multimediali di Windows" },
{ L"Tocar/pausar, próxima e anterior vão para o Windows, com o painel de mídia dele.", L"Riproduci/pausa, successivo e precedente vanno a Windows, con il suo pannello multimediale." },
{ L"Apps do Windows", L"App di Windows" },
{ L"O visual do Mac continua; estes abrem o app do Windows no lugar do app do WacOS.", L"L’aspetto Mac resta; queste aprono l’app di Windows al posto di quella di WacOS." },
